# Copy to `backend_config.env` (or `.env`) for local development. On Render, set these as environment variables.
# Nothing in this file is a real credential - never commit the filled-in copy.

# ── Required ───────────────────────────────────────────────────────────────────
# At least 32 random characters:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Supabase: Project Settings -> Database -> Connection string -> "Session pooler" (IPv4, works on Render).
# Local development can use SQLite instead:  sqlite+aiosqlite:///./dev.db
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# https://aistudio.google.com/app/apikey  (use a PAID-tier key in production - see README "Privacy")
GEMINI_API_KEY=

# ── Admin portal sign-in (there is NO default password: without one, admin login is disabled) ──
ADMIN_USERNAME=beaconai
# Generate with:  python -m app.tools.hash_password      (or set ADMIN_PASSWORD for a plaintext secret)
ADMIN_PASSWORD_HASH=

# ── Evidence storage (Supabase Storage, PRIVATE bucket) ──────────────────────────
SUPABASE_URL=https://PROJECT_REF.supabase.co
# The *secret* key (sb_secret_...) or the legacy service_role key. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=evidence

# ── Web ─────────────────────────────────────────────────────────────────────────
# Origins allowed to call the API from a browser (the admin portal). JSON array or comma separated.
CORS_ORIGINS=["https://your-admin-portal.vercel.app"]

# ── Optional ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=production            # development | production   (production hides /api/v1/docs)
LOG_LEVEL=INFO
# Override the model fallback chains (comma separated, best first). Leave unset to use the built-in defaults.
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# GEMINI_FAST_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash,gemini-3.6-flash
# GEMINI_AUTO_DISCOVER=true       # ask the API which models exist and adapt the chain automatically
